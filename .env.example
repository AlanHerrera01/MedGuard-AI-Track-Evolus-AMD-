# =============================================================================
# MedGuard AI — Plantilla de variables de entorno
# Copia este archivo a `.env` y rellena los valores reales.
# NUNCA subas el archivo `.env` al repositorio.
# =============================================================================

# -----------------------------------------------------------------------------
# Backend (FastAPI)
# -----------------------------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Orígenes permitidos por CORS (separados por coma)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# -----------------------------------------------------------------------------
# Evolus AI (API REST)
# -----------------------------------------------------------------------------
EVOLUS_BASE_URL=https://api.evolus.example.com/v1
EVOLUS_API_KEY=
EVOLUS_APPLICATION_ID=
EVOLUS_TIMEOUT_SECONDS=30

# -----------------------------------------------------------------------------
# AMD Cloud / TokenFactory (API OpenAI-compatible)
# -----------------------------------------------------------------------------
AMD_CLOUD_BASE_URL=https://cloud.amd.example.com
AMD_API_KEY=
AMD_TOKEN_ENDPOINT=https://notebooks.amd.com/tokenfactory/v1
AMD_MODEL_NAME=meta-llama/Llama-3.1-8B-Instruct
AMD_TEMPERATURE=0.0
AMD_TIMEOUT_SECONDS=60

# -----------------------------------------------------------------------------
# Modelo / LLM
# -----------------------------------------------------------------------------
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048

# -----------------------------------------------------------------------------
# Frontend (Vite) — expuestas al navegador, NO pongas secretos aquí
# -----------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000
VITE_APP_NAME=MedGuard AI
