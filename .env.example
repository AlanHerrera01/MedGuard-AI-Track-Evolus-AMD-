# =============================================================================
# MedGuard AI — Plantilla de variables de entorno
# Copia este archivo a `.env` y rellena los valores reales.
# NUNCA subas el archivo `.env` al repositorio.
# =============================================================================

# -----------------------------------------------------------------------------
# Variables compartidas
# -----------------------------------------------------------------------------
# Puerto del backend (usado por docker-compose.yml)
BACKEND_PORT=8000
# Puerto del frontend (usado por docker-compose.yml)
FRONTEND_PORT=5173

# -----------------------------------------------------------------------------
# Backend (FastAPI) - Variables de entorno del contenedor
# -----------------------------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# -----------------------------------------------------------------------------
# Evolus AI (API REST) - Backend
# -----------------------------------------------------------------------------
EVOLUS_BASE_URL=https://api.evolus.example.com/v1
EVOLUS_API_KEY=tu-api-key-de-evolus-aqui
EVOLUS_APPLICATION_ID=tu-application-id-de-evolus-aqui
EVOLUS_TIMEOUT_SECONDS=30

# -----------------------------------------------------------------------------
# AMD Cloud / TokenFactory (API OpenAI-compatible) - Backend
# -----------------------------------------------------------------------------
# Modo del conector dual del Agente Auditor (desarrollo híbrido local):
#   auto -> usa vLLM/ROCm real si AMD_TOKEN_ENDPOINT + AMD_API_KEY están
#           definidos; si la instancia aún no está habilitada, simula la
#           respuesta localmente (modo mock, sin red).
#   live -> siempre llama a la GPU AMD real.
#   mock -> nunca llama a AMD; auditoría determinista simulada localmente.
AMD_MODE=auto
AMD_CLOUD_BASE_URL=https://cloud.amd.example.com
AMD_API_KEY=tu-api-key-de-amd-aqui
AMD_TOKEN_ENDPOINT=https://notebooks.amd.com/tokenfactory/v1
AMD_MODEL_NAME=meta-llama/Llama-3.1-8B-Instruct
AMD_TEMPERATURE=0.0
AMD_TIMEOUT_SECONDS=60

# -----------------------------------------------------------------------------
# LLM Provider
# -----------------------------------------------------------------------------
# Proveedor de LLM: "gemini" (OpenAI no se usa en este proyecto)
LLM_PROVIDER=gemini

# -----------------------------------------------------------------------------
# Gemini - Backend
# -----------------------------------------------------------------------------
GEMINI_API_KEY=tu-api-key-de-gemini-aqui
GEMINI_MODEL=gemini-2.5-flash

# -----------------------------------------------------------------------------
# Frontend (Vite) - Variables de entorno para build (NO pongas secretos aquí)
# -----------------------------------------------------------------------------
# Esta variable se "hornea" en el bundle durante el build y se expone al navegador
VITE_API_BASE_URL=http://localhost:8000
VITE_APP_NAME=MedGuard AI
